<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Azure Kostencheck</title>
<style>
  :root { --fg:#1b1f24; --muted:#5b6470; --line:#e3e6ea; --accent:#0a66c2; --bad:#b42318; --bg:#fff; --card:#f6f8fa; }
  @media (prefers-color-scheme: dark) {
    :root { --fg:#e6e8eb; --muted:#9aa4af; --line:#30363d; --accent:#4ea1ff; --bad:#ff7b72; --bg:#0d1117; --card:#161b22; }
  }
  body { font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--fg); background: var(--bg); margin: 0; padding: 32px 16px; }
  main { max-width: 1000px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  .meta { color: var(--muted); margin-bottom: 24px; }
  .demo { background: var(--card); border-left: 4px solid var(--accent); padding: 8px 12px; margin-bottom: 16px; }
  .total { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin-bottom: 28px; }
  .total .big { font-size: 34px; font-weight: 700; color: var(--bad); }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 13px; color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  code { font-size: 13px; }
  code.cmd { display: inline-block; margin-top: 4px; color: var(--muted); word-break: break-all; }
  h2 { font-size: 18px; margin: 28px 0 8px; }
  a { color: var(--accent); }
  .sev { font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 10px; white-space: nowrap; border: 1px solid var(--line); }
  .sev-high { color: var(--bad); border-color: var(--bad); }
  .sev-medium { color: var(--accent); border-color: var(--accent); }
  footer { color: var(--muted); font-size: 13px; margin-top: 28px; }
</style>
</head>
<body>
<main>
  <h1>Azure Kostencheck: Verschwendungsbericht</h1>
  <div class="meta">Bereich <code>{{ scope }}</code> · {{ today }}</div>
  {% if demo %}<div class="demo"><strong>Demo-Daten:</strong> fiktive Subscriptions und Beispielpreise, keine echte Umgebung.</div>{% endif %}

  <div class="total">
    Sie verlieren ca.
    <div class="big">{{ summary.monthly_eur | eur }} pro Monat</div>
    ≈ {{ summary.yearly_eur | eur }} pro Jahr durch {{ summary.count }} ungenutzte Ressourcen.
    {% if summary.monthly_cost_eur != summary.monthly_eur %}<br>Die Ressourcen kosten zusammen ca. {{ summary.monthly_cost_eur | eur }} pro Monat; eingespart wird weniger, weil verkleinerte Ressourcen weiter etwas kosten (Spalten „Kosten“ und „Einsparung“).{% endif %}
    {% if summary.unpriced %}<br>{{ summary.unpriced }} Ressource(n) ohne Preis, nicht in der Summe enthalten.{% endif %}
    {% if summary.ignored %}<br>{{ summary.ignored }} Ressource(n) ignoriert (Tag <code>waste-finder:ignore=true</code> oder Ausschluss in der Konfiguration).{% endif %}
    {% if summary.below_threshold %}<br>{{ summary.below_threshold }} Ressource(n) unter der Schwelle von {{ min_savings | eur }} pro Monat nicht aufgeführt.{% endif %}
    {% if summary.cleanup %}<br>Dazu {{ summary.cleanup }} kostenlose Ressource(n) zum Aufräumen, nicht in der Summe enthalten (Abschnitt „Aufräumen (kostenlos)“).{% endif %}
  </div>

  {% for group in groups %}
  <h2>Subscription <code>{{ group.subscription_id or "unbekannt" }}</code></h2>
  <p>Ca. <strong>{{ group.monthly_eur | eur }} pro Monat</strong> durch {{ group.findings | length }} Ressource(n).</p>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Ressource</th><th>Problem</th><th>Priorität</th><th>Ressourcengruppe</th><th>SKU</th><th class="num">Kosten {{ currency_symbol }}/Monat</th><th class="num">Einsparung {{ currency_symbol }}/Monat</th><th>Empfehlung</th></tr></thead>
    <tbody>
    {% for f in group.findings %}
      <tr>
        <td><code>{{ f.name }}</code></td>
        <td>{{ rules[f.rule].title_de }}</td>
        <td><span class="sev sev-{{ f.severity }}">{{ severities[f.severity] }}</span></td>
        <td>{{ f.resource_group }}</td>
        <td>{{ f.sku }}{% if f.size_gb %} ({{ f.size_gb }} GB){% endif %}{% if f.age_days is not none %}, {{ f.age_days }} {{ rules[f.rule].age_label_de }}{% endif %}{% if f.quantity is not none and rules[f.rule].quantity_unit_de %}, {{ f.quantity }} {{ rules[f.rule].quantity_unit_de }}{% endif %}</td>
        <td class="num">{{ f.monthly_cost_eur | eur }}</td>
        <td class="num">{{ f.savings_eur | eur }}</td>
        <td>{{ rules[f.rule].action_de }}<br><code class="cmd">{{ rules[f.rule].remediation_command(f.resource_id) }}</code></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p>Keine verschwendeten Ressourcen gefunden.</p>
  {% endfor %}

  {% if cleanup %}
  <h2 id="aufraeumen">Aufräumen (kostenlos)</h2>
  <p>Diese Ressourcen kosten nichts und zählen nicht zur Summe oben. Aufräumen schafft Übersicht und vermeidet Fehler.</p>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Ressource</th><th>Problem</th><th>Subscription</th><th>Ressourcengruppe</th><th>Empfehlung</th></tr></thead>
    <tbody>
    {% for f in cleanup %}
      <tr>
        <td><code>{{ f.name }}</code></td>
        <td>{{ rules[f.rule].title_de }}</td>
        <td><code>{{ f.subscription_id or "unbekannt" }}</code></td>
        <td>{{ f.resource_group }}</td>
        <td>{{ rules[f.rule].action_de }}<br><code class="cmd">{{ rules[f.rule].remediation_command(f.resource_id) }}</code></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <ul>
  {% for rule_id in cleanup | map(attribute="rule") | unique %}
    <li><strong>{{ rules[rule_id].title_de }}:</strong> {{ rules[rule_id].why_de }} (<a href="{{ rules[rule_id].docs_url }}">Doku</a>)</li>
  {% endfor %}
  </ul>
  {% endif %}

  <h2>Warum kostet das Geld?</h2>
  <ul>
  {% for rule in rules.values() if rule.pricing != "free" %}
    <li><strong>{{ rule.title_de }}:</strong> {{ rule.why_de }} (<a href="{{ rule.docs_url }}">Doku</a>)</li>
  {% endfor %}
  </ul>

  <footer>Das Tool ändert nichts in der Subscription; die Befehle erst prüfen, dann ausführen.<br>Preise: Azure Retail Prices API (Listenpreise in {{ currency }}, 730 h/Monat). Tatsächliche Preise können durch Rabatte (EA/CSP, Reservierungen, Azure Hybrid Benefit) abweichen.</footer>
</main>
</body>
</html>
